rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════════
    // Helper Functions
    // ═══════════════════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    // Safely get the caller's user doc — returns null-safe data
    function callerData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function callerRole() {
      return callerData().role;
    }

    function isSuperAdmin() {
      return isSignedIn() && callerRole() == 'superadmin';
    }

    function isOwnerOf(companyId) {
      return isSignedIn()
        && callerRole() == 'owner'
        && callerData().companyId == companyId;
    }

    function isAnyOwner() {
      return isSignedIn() && callerRole() == 'owner';
    }

    // ═══════════════════════════════════════════════════════════════════════
    // 1. superadmin collection — bootstrap config
    // ═══════════════════════════════════════════════════════════════════════
    //
    // On first Super Admin login the app calls:
    //   createUser(sa)       → writes users/{uid}
    //   seedSuperAdmin(...)  → writes superadmin/config
    //
    // At that point users/{uid} already exists with role='superadmin',
    // so isSuperAdmin() succeeds for the seedSuperAdmin write.
    //
    // Read is also limited to Super Admin.
    match /superadmin/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // 2. companies collection
    // ═══════════════════════════════════════════════════════════════════════
    match /companies/{companyId} {
      // Super Admin sees all; owner sees their own company
      allow read: if isSignedIn() && (
        isSuperAdmin() || isOwnerOf(companyId)
      );
      // Only Super Admin creates/updates/deletes companies
      allow write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // 3. users collection
    // ═══════════════════════════════════════════════════════════════════════
    //
    // Query patterns used by the app:
    //   getUserByPhone(phone)         → whereEqualTo("phone", phone)
    //   observeDriversForOwner(...)   → whereEqualTo("companyId",...) + whereEqualTo("role","driver")
    //   observeAllUsers()             → full collection (Super Admin only)
    //
    match /users/{uid} {

      // ── READ ──
      // a) Any authenticated user can read their own doc
      // b) Super Admin can read any user doc (observeAllUsers)
      // c) Owner can read users in their company (observeDriversForOwner)
      // d) Any authenticated user can read a doc that matches their phone
      //    (needed for getUserByPhone during login/migration)
      allow read: if isSignedIn() && (
        request.auth.uid == uid
        || isSuperAdmin()
        || (isAnyOwner() && resource.data.companyId == callerData().companyId)
        || resource.data.phone == request.auth.token.phone_number
      );

      // ── CREATE ──
      // a) Super Admin creates owners (addOwner) and seeds own user doc on first login
      // b) Owner creates drivers (addDriver) — only role='driver' with same companyId
      // c) Authenticated user creates own doc during UID migration
      //    (phone auth UID differs from pending_ UID, app copies doc to new UID)
      allow create: if isSignedIn() && (
        isSuperAdmin()
        || (isAnyOwner()
            && request.resource.data.role == 'driver'
            && request.resource.data.companyId == callerData().companyId)
        || (request.auth.uid == uid
            && request.resource.data.phone == request.auth.token.phone_number)
      );

      // ── UPDATE ──
      // a) User updates own fcmToken only (single field)
      // b) Super Admin can update any user
      // c) Owner can update drivers in their company (e.g., exitPin changes)
      allow update: if isSignedIn() && (
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken']))
        || isSuperAdmin()
        || (isAnyOwner()
            && resource.data.companyId == callerData().companyId
            && resource.data.role == 'driver')
      );

      // ── DELETE ──
      // Super Admin deletes owners; owners delete their company's drivers
      allow delete: if isSignedIn() && (
        isSuperAdmin()
        || (isAnyOwner()
            && resource.data.companyId == callerData().companyId
            && resource.data.role == 'driver')
      );
    }

    // ═══════════════════════════════════════════════════════════════════════
    // 4. trips collection
    // ═══════════════════════════════════════════════════════════════════════
    //
    // Query patterns:
    //   observeActiveTrip(driverId)   → whereEqualTo("driverId",...) + whereEqualTo("status","active")
    //   observeTripsForOwner(ownerId) → whereEqualTo("ownerId",...)
    //   observeAllTrips()             → full collection (Super Admin)
    //
    match /trips/{tripId} {

      // ── READ ──
      // Driver reads own trips; owner reads trips they created; Super Admin reads all
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || request.auth.uid == resource.data.driverId
        || request.auth.uid == resource.data.ownerId
      );

      // ── CREATE ──
      // Only owners create trips (assignTrip)
      allow create: if isSignedIn() && (
        isSuperAdmin()
        || (isAnyOwner() && request.resource.data.ownerId == request.auth.uid)
      );

      // ── UPDATE ──
      // Driver updates location + status (trip completion, high risk escalation)
      // Owner updates status; Super Admin can update anything
      allow update: if isSignedIn() && (
        isSuperAdmin()
        || request.auth.uid == resource.data.driverId
        || request.auth.uid == resource.data.ownerId
      );

      // ── DELETE ──
      // Owner can delete their trips (trip history cleanup); Super Admin can delete any
      allow delete: if isSignedIn() && (
        isSuperAdmin()
        || request.auth.uid == resource.data.ownerId
      );
    }

    // ═══════════════════════════════════════════════════════════════════════
    // 5. events collection
    // ═══════════════════════════════════════════════════════════════════════
    //
    // Query patterns:
    //   observeEventsForTrip(tripId) → whereEqualTo("tripId",...) + orderBy("timestamp")
    //
    match /events/{eventId} {

      // ── READ ──
      // Driver reads own events; trip owner reads events; Super Admin reads all
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || request.auth.uid == resource.data.driverId
        || request.auth.uid == resource.data.companyId
        || (isAnyOwner()
            && resource.data.companyId == callerData().companyId)
      );

      // ── CREATE ──
      // Drivers write their own impairment events; Super Admin can write any
      allow create: if isSignedIn() && (
        isSuperAdmin()
        || request.auth.uid == request.resource.data.driverId
      );

      // No update or delete for events — they're immutable audit records
      allow update, delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // 6. otps collection
    // ═══════════════════════════════════════════════════════════════════════
    //
    // OTP docs are keyed by tripId. Both the driver (validateOtp) and
    // owner (writeOtp) need access to the trip's OTP doc.
    //
    match /otps/{tripId} {

      // Must be a participant of the trip (driver or owner) or Super Admin
      allow read, write: if isSignedIn() && (
        isSuperAdmin()
        || get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid
        || get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == request.auth.uid
      );
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Catch-all: deny everything not explicitly allowed
    // ═══════════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
